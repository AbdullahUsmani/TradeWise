{
  "entities": {
    "advisor": {
      "title": "Advisor",
      "description": "An investment advisor or trading agent profile",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "sebiRegNo": { "type": "string" },
        "color": { "type": "string" },
        "badgeBg": { "type": "string" },
        "description": { "type": "string" },
        "strategyStyle": { "type": "string" },
        "feeStructure": { "type": "string" },
        "contactEmail": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "name", "type", "color", "badgeBg", "strategyStyle"]
    },
    "portfolio": {
      "title": "Advisor Portfolio",
      "description": "A sub-portfolio or strategy basket under an advisor",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "advisorId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string" },
        "status": {
          "type": "string",
          "enum": ["ACTIVE", "INACTIVE"],
          "description": "Lifecycle status of the portfolio (Active or Inactive)"
        },
        "activationDate": {
          "type": "string",
          "description": "Date when portfolio was activated (YYYY-MM-DD)"
        },
        "deactivationDate": {
          "type": "string",
          "description": "Date when portfolio was deactivated (YYYY-MM-DD)"
        },
        "description": { "type": "string" },
        "targetAllocationPct": { "type": "number" },
        "color": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "advisorId", "name", "type"]
    },
    "transaction": {
      "title": "Transaction",
      "description": "Stock trade execution record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "advisorId": { "type": "string" },
        "portfolioId": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "sector": { "type": "string" },
        "marketCap": { "type": "string" },
        "type": { "type": "string" },
        "date": { "type": "string" },
        "quantity": { "type": "number" },
        "price": { "type": "number" },
        "charges": { "type": "number" },
        "notes": { "type": "string" },
        "tradeTag": { "type": "string" }
      },
      "required": ["id", "advisorId", "symbol", "name", "type", "date", "quantity", "price"]
    },
    "dividend": {
      "title": "Dividend",
      "description": "Corporate dividend distribution entry",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "advisorId": { "type": "string" },
        "portfolioId": { "type": "string" },
        "symbol": { "type": "string" },
        "name": { "type": "string" },
        "exDate": { "type": "string" },
        "creditDate": { "type": "string" },
        "sharesEligible": { "type": "number" },
        "perShareAmount": { "type": "number" },
        "totalAmount": { "type": "number" },
        "tdsDeducted": { "type": "number" },
        "notes": { "type": "string" }
      },
      "required": ["id", "advisorId", "symbol", "name", "creditDate", "sharesEligible", "totalAmount"]
    },
    "userPortfolioDoc": {
      "title": "User Portfolio Document",
      "description": "Consolidated portfolio document containing advisors, portfolios, transactions, dividends, and stock quotes for high efficiency sync",
      "type": "object",
      "properties": {
        "advisors": { "type": "array" },
        "portfolios": { "type": "array" },
        "transactions": { "type": "array" },
        "dividends": { "type": "array" },
        "quotes": { "type": "object" },
        "lastUpdated": { "type": "string" },
        "dataVersion": { "type": "string" }
      }
    }
  },
  "firestore": {
    "/users/{userId}/portfolio/{docId}": {
      "schema": { "$ref": "#/entities/userPortfolioDoc" },
      "description": "Consolidated portfolio record for a user"
    },
    "/users/{userId}/advisors/{advisorId}": {
      "schema": { "$ref": "#/entities/advisor" },
      "description": "User advisor profile"
    },
    "/users/{userId}/transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/transaction" },
      "description": "User trade transaction"
    },
    "/users/{userId}/dividends/{dividendId}": {
      "schema": { "$ref": "#/entities/dividend" },
      "description": "User dividend record"
    }
  }
}
