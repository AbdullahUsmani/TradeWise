rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Connection test document for health checks
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }
    
    // User root document and any subcollections under /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }

    // Root collections for compatibility
    match /advisors/{advisorId} {
      allow read, write: if isAuthenticated();
    }

    match /portfolios/{portfolioId} {
      allow read, write: if isAuthenticated();
    }
    
    match /transactions/{txId} {
      allow read, write: if isAuthenticated();
    }
    
    match /dividends/{dividendId} {
      allow read, write: if isAuthenticated();
    }
    
    match /quotes/{quoteId} {
      allow read, write: if isAuthenticated();
    }
  }
}


